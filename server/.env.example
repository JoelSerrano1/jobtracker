# MongoDB connection string. Two options:
# 1) Local MongoDB (default):      mongodb://localhost:27017/jobtracker
# 2) MongoDB Atlas free cluster:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobtracker
#    Create one free at https://www.mongodb.com/atlas > "Try Free" > "Build a Cluster".
#    Whitelist your IP (Network Access) and create a database user first.
MONGO_URI=mongodb://localhost:27017/jobtracker

# API port
PORT=5000